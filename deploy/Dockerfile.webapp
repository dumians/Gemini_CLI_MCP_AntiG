# Build stage
FROM node:20-slim AS build
WORKDIR /app

# Copy package files from the UIX directory
COPY UIX/package*.json ./
RUN npm install --include=dev

# Copy the rest of the UIX source
COPY UIX/ .

# Build argument for the API URL
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV PATH="/app/node_modules/.bin:$PATH"

RUN npm run build

# Production stage
FROM nginx:alpine

COPY deploy/entrypoint-webapp.sh /docker-entrypoint.d/99-env-config.sh
RUN chmod +x /docker-entrypoint.d/99-env-config.sh

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

ENTRYPOINT ["/docker-entrypoint.d/99-env-config.sh"]
