{
    "name": "agentic-mesh-multi-domain-demo",
    "version": "1.0.5",
    "description": "Enterprise Data Agents Demo across multiple domains, secured and grounded",
    "main": "agent/index.js",
    "type": "module",
    "scripts": {
        "start": "node agent/index.js",
        "start-one-mcp": "node servers/one-mcp/index.js",
        "start-oracle-mcp": "node servers/oracle-mcp/index.js",
        "start-spanner-mcp": "node servers/spanner-mcp/index.js",
        "start-bigquery-mcp": "node servers/bigquery-mcp/index.js",
        "setup-bq-governance": "node scripts/create_bq_governance_demo.js",
        "test": "node --test tests/unit/mcps/*.test.js tests/integration/*.test.js",
        "test:unit": "node --test tests/unit/mcps/*.test.js",
        "test:integration": "node --test tests/integration/*.test.js"
    },
    "dependencies": {
        "@google-cloud/alloydb": "^3.1.0",
        "@google-cloud/bigquery": "^9.0.3",
        "@google-cloud/dataplex": "^6.0.0",
        "@google-cloud/modelarmor": "^0.8.0",
        "@google-cloud/spanner": "^8.11.0",
        "@google/generative-ai": "^0.24.0",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "oracledb": "^7.0.1",
        "pg": "^8.23.0"
    }
}
